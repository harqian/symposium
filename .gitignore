# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# links_to_profile pipeline
#
# Default: share everything with collaborators. Only ignore (a) really large
# files (over GitHub's 100 MB single-file limit, or hundreds of MB total) and
# (b) build/runtime artifacts. Output profiles, axis names, PCA model, and
# the per-user data ride along in the repo.

# raw Curius export (108 MB, re-exportable from Curius)
links_to_profile/curius_export_*.json
# fetched markdown bulk (2+ GB) and embedding binaries (800 MB → 2.4 GB)
links_to_profile/data/pages/
links_to_profile/embeddings/
# big derived intermediate, trivially regenerable from filter_export
links_to_profile/data/corpus_pages.jsonl
# venv + caches + logs
links_to_profile/.venv/
links_to_profile/__pycache__/
links_to_profile/**/__pycache__/
links_to_profile/logs/
# legacy joblib path (we use pca_model.npz now)
links_to_profile/axes/pca_model.pkl
